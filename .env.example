# Mohsin FutureTech — environment variables
# Copy to .env.local and fill in the real values from the Supabase Dashboard
# (Project Settings -> API). NEVER commit .env.local or real keys to GitHub.
# .env.local is already excluded by .gitignore.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase "anon public" key (safe to expose in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase "service_role" key — SERVER ONLY. Bypasses RLS. Never expose it
# in browser code and never share it in chat or screenshots.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# EasyPaisa / JazzCash / NayaPay accounts for manual payment verification (Step 4).
# These are PUBLIC (shown to customers at checkout) — they are account
# names/numbers, not secrets. Leave blank until the store owner provides
# the real accounts; the site shows a clear placeholder meanwhile.
# NEVER put a real account number in chat — set it here in .env.local.
NEXT_PUBLIC_EASYPAISA_ACCOUNT_NAME=
NEXT_PUBLIC_EASYPAISA_ACCOUNT_NUMBER=
NEXT_PUBLIC_JAZZCASH_ACCOUNT_NAME=
NEXT_PUBLIC_JAZZCASH_ACCOUNT_NUMBER=
NEXT_PUBLIC_NAYAPAY_ACCOUNT_NAME=
NEXT_PUBLIC_NAYAPAY_ACCOUNT_NUMBER=
