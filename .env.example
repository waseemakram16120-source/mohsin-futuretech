# Mohsin FutureTech — environment variables
# Copy to .env.local and fill in values from Supabase Dashboard → Project
# Settings → API. .env.local is git-ignored: NEVER commit real keys.

# Public (sent to the browser). Safe to expose; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# The site's public URL (used for auth redirects and SEO). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_, never paste in chat or screenshots.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tests only: local Postgres started by `npm run db:start`.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# ---------------------------------------------------------------------------
# Payments (SERVER ONLY — see docs/PAYMENTS.md). Never commit real values.
# ---------------------------------------------------------------------------
# sandbox | production
PAYMENTS_ENV=sandbox
# Must be "true" (owner approval) before any production payment can run.
PAYMENTS_LIVE_ENABLED=false
# Public site URL used for provider callbacks; https required in production.
PAYMENTS_PUBLIC_BASE_URL=http://localhost:3000
# Bearer token for POST /api/payments/reconcile (32+ random characters).
PAYMENTS_RECONCILE_SECRET=
# 1 = internal sandbox test gateway (NOT JazzCash/Easypaisa; refused in production).
PAYMENTS_TEST_GATEWAY=

# JazzCash merchant credentials (from the JazzCash merchant portal).
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_API_BASE_URL=

# Easypaisa merchant credentials (from the Easypaisa merchant portal).
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_API_BASE_URL=
